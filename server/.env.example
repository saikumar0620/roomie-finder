PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Neon Pooled connection string (used by Prisma runtime)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&schema=roomie_finder

# Neon Direct connection string (used by `npx prisma db push` - no -pooler)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&schema=roomie_finder

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Cloudinary (required for persistent image uploads in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo HTTPS Email API (recommended - 300 free emails/day, works on Render)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com
